{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chatcut": {
        "type": "remote",
        "url": "https://api.chatcut.io/api/external-mcp/mcp",
        "disabled": true
      },
      "openchatcut": {
        "type": "remote",
        "url": "http://localhost:5199/api/external-mcp/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:OPENCHATCUT_MCP_TOKEN}"
        }
      }
    }
  }
}
